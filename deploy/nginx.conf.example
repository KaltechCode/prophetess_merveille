# Self-managed VPS only. For SPanel-managed servers, ask ScalaHosting support
# to apply equivalent settings in the existing web server; do not replace it.
# Install a valid TLS certificate before enabling this example.
server {
    listen 80;
    server_name celebrate.example.com;
    return 301 https://celebrate.example.com$request_uri;
}
server {
    listen 443 ssl;
    server_name celebrate.example.com;
    ssl_certificate /etc/letsencrypt/live/celebrate.example.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/celebrate.example.com/privkey.pem;
    client_max_body_size 32k;
    add_header X-Content-Type-Options nosniff always;
    add_header Referrer-Policy strict-origin-when-cross-origin always;
    add_header X-Frame-Options DENY always;
    add_header Permissions-Policy "camera=(), microphone=(), geolocation=()" always;
    location / {
        proxy_pass http://127.0.0.1:3000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_buffering off;
        proxy_read_timeout 60s;
    }
    # This application's /admin and /api must never be response-cached.
}
