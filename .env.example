# All values are runtime, server-only variables. No NEXT_PUBLIC secrets.
APP_ORIGIN=https://celebrate.example.com
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_ME
SUPABASE_SECRET_KEY=sb_secret_REPLACE_ME
# UUID from Supabase Authentication > Users (not an email address).
ADMIN_USER_ID=REPLACE_WITH_CONFIRMED_ADMIN_USER_UUID
# Generate with: openssl rand -hex 32
RATE_LIMIT_SECRET=REPLACE_WITH_RANDOM_64_HEX_CHARACTERS
MAIL_HOST=mail.example.com
MAIL_PORT=465
MAIL_USER=REPLACE_ME
MAIL_PASS=REPLACE_ME
MAIL_FROM=notifications@give.org
MAIL_FROM_NAME=Prophetess Merveille
NOTIFY_EMAIL=notifications@give.org
